# Repository text is normalized on add; working-tree EOL remains a local Git choice.
* text=auto

# Text formats that must not rely on automatic content detection.
*.cjs text
*.cts text
*.css text
*.csv text
*.env text
*.geojson text
*.gitattributes text
*.gitignore text
*.html text
*.ini text
*.json text
*.jsonl text
*.jsx text
*.lock text
*.md text
*.mjs text
*.mts text
*.npmrc text
*.ps1 text
*.sh text
*.svg text
*.toml text
*.ts text
*.tsv text
*.tsx text
*.txt text
*.xml text
*.yaml text
*.yml text
.editorconfig text
.nvmrc text
.prettierignore text
.vercelignore text
Dockerfile text
LICENSE text
Makefile text
package-lock.json text

